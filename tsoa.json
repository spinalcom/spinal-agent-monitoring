{
	"entryFile": "src/api/index.ts",
	"noImplicitAdditionalProperties": "silently-remove-extras",
	"controllerPathGlobs": ["src/api/controllers/*Controller.ts"],
	"spec": {
		"name": "spinal-organ-health",
		"description": "API for Spinal Organ Health Monitoring",
		"contact": {
			"name": "SpinalCom",
			"email": "developers@spinalcom.com"
		},
		"outputDirectory": "src/api/swagger",
		"specVersion": 3,
		"securityDefinitions": {
			"jwt": {
				"type": "oauth2",
				"flows": {
					"password": {
						"tokenUrl": "/auth/login",
						"scopes": {}
					}
				}
			}
		}
	},
	"routes": {
		"routesDir": "src/api",
		"middleware": "express"
	}
}
